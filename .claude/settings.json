{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migration-surface.sh\"",
            "statusMessage": "Checking StableStaker golden-rule migration surface"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migration-surface.sh\"",
            "statusMessage": "Checking StableStaker golden-rule migration surface"
          }
        ]
      }
    ]
  }
}
